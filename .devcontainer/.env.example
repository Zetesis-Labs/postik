# Copia este fichero a .devcontainer/.env; .env no se versiona.
POSTIK_SUPERADMIN_USERNAME=admin
POSTIK_SUPERADMIN_PASSWORD=admin
# Semilla TOTP en base32. Con ella, el 2FA del superadmin es obligatorio.
# POSTIK_SUPERADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
# POSTIK_SUPERADMIN_RECOVERY_CODES=alfa-1234,beta-5678

# Proveedor OIDC. Por defecto, el falso de `make dev` en http://localhost:5556.
# Para Zetesis-Auth u otro proveedor real, cambia estas cuatro:
# POSTIK_OIDC_ISSUER=https://auth.zetesis.xyz/realms/zetesis
# POSTIK_OIDC_CLIENT_ID=postik
# POSTIK_OIDC_CLIENT_SECRET=...
# POSTIK_OIDC_DISPLAY_NAME=Zetesis
# POSTIK_REQUIRE_INVITATION=false
